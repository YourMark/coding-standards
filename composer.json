{
  "name": "yourmark/coding-standards",
  "description": "YourMark's PHPCS ruleset and PHPStan config for WordPress projects.",
  "type": "phpcodesniffer-standard",
  "license": "MIT",
  "keywords": ["phpcs", "phpstan", "wordpress", "coding-standards", "static-analysis"],
  "authors": [
    {
      "name": "Mark Jansen",
      "email": "mark@yourmark.nl"
    }
  ],
  "require": {
    "php": ">=7.4",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^3.13",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "scripts": {
    "test": [
      "phpcs --standard=YourMark tests/fixtures/pass.php",
      "! phpcs -q --standard=YourMark tests/fixtures/fail.php",
      "phpstan analyse -c tests/phpstan.neon --no-progress"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
